# The API reads .env automatically from travel-planner-api/.
# For Goose and integration tests in Git Bash: set -a; source .env; set +a
PORT=8080
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/travel_planner?sslmode=disable
# Integration tests require a separate database with migrations applied.
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/travel_planner_test?sslmode=disable
